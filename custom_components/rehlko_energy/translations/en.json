          "name": "Generator",
          "description": "The generator (or its transfer switch) to act on."
        },
        "mode": {
          "name": "Mode",
          "description": "How to run it; defaults to the scheduled exercise's mode."
        }
      }
    },
    "stop_exercise": {
      "name": "Stop exercise",
      "description": "Stop the exercise that is running.",
      "fields": {
